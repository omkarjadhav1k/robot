# ==============================================================================
# Business AI Robot — Environment Configuration Template
# Copy this file to .env and configure with your local or production credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Business AI Robot"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Binding
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database
DATABASE_URL="postgresql://robot_user:robot_password@localhost:5432/business_ai_robot"

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# Robot Configuration
DEFAULT_ROBOT_ID="ROBOT-001"
ROBOT_SHARED_SECRET="replace-with-robot-api-secret"
HEARTBEAT_TIMEOUT_SECONDS=60

# Speech Configuration
DEFAULT_LANGUAGE="en"
AVAILABLE_LANGUAGES=["en", "hi", "mr"]
